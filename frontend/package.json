{
  "name": "personal-finance-ledger-frontend",
  "private": true,
  "scripts": {
    "build": "npm run build:css && npm run vendor",
    "build:css": "tailwindcss -c tailwind.config.js -i src/input.css -o ../src/main/resources/static/css/app.css --minify",
    "vendor": "cp node_modules/htmx.org/dist/htmx.min.js ../src/main/resources/static/js/htmx.min.js && cp node_modules/chart.js/dist/chart.umd.js ../src/main/resources/static/js/chart.umd.js"
  },
  "devDependencies": {
    "chart.js": "4.6.1",
    "htmx.org": "2.0.11",
    "tailwindcss": "4.3.5"
  }
}
